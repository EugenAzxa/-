# Настройки для хостинга REG.RU (Apache). На Vercel не используется.
AddDefaultCharset UTF-8
DirectoryIndex index.html
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
RewriteEngine On

# без www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ http://%1%{REQUEST_URI} [L,R=301]

# на https: включить (убрать # у двух строк ниже) только ПОСЛЕ того, как в панели REG.RU
# выпущен SSL-сертификат и сайт открывается по https://. Перед Apache стоит nginx,
# поэтому смотрим X-Forwarded-Proto, иначе будет бесконечная переадресация.
# RewriteCond %{HTTP:X-Forwarded-Proto} !https
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# /index.html -> /
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^ / [L,R=301]

# /seo.html -> /seo (чистые адреса как на Vercel)
RewriteCond %{THE_REQUEST} \s/([^.?\s]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [L,R=301]

# /seo -> seo.html, /blog -> blog/index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# служебные папки не отдаём
RewriteRule ^(_blog|_tools|_src|\.git|\.vercel)(/|$) - [F,L]
</IfModule>

<IfModule mod_headers.c>
<FilesMatch "\.(webp|jpg|png|svg|mp4)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(css|js|html|xml|txt)$">
  Header set Cache-Control "public, max-age=0, must-revalidate"
</FilesMatch>
</IfModule>

<IfModule mod_mime.c>
AddType image/webp .webp
AddType video/mp4 .mp4
AddType text/plain .txt
</IfModule>

ErrorDocument 404 /index.html
